# Copy this file to .env.local. Never commit real service credentials.
# Optional: enables a direct email link and mailto draft fallback.
VITE_CONTACT_EMAIL=

# Optional: set all three to enable the original EmailJS delivery path.
# Configure the EmailJS template fields: user_name, user_email, message.
# VITE values are public in the client bundle; use EmailJS's public key only.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
